FROM --platform=linux/amd64 debian:bookworm-slim AS builder
ARG DEBIAN_FRONTEND=noninteractive

# Install build tools on amd64 host (no QEMU needed here)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        debootstrap \
        gawk \
        git \
        make \
        qemu-user-static \
    && rm -rf /var/lib/apt/lists/*

# Build i386 Debian rootfs via debootstrap (runs on amd64, no QEMU socket issues)
RUN debootstrap \
        --foreign \
        --arch=i386 \
        --variant=minbase \
        --include=apt-utils,gcc,python3,vim,unzip,ruby,nodejs,fakeroot,hexedit,patch,file,luajit,make,lua5.3,curl,less,cowsay,netcat-openbsd,passwd,ca-certificates \
        buster /rootfs http://archive.debian.org/debian

RUN cp /usr/bin/qemu-i386-static /rootfs/usr/bin/

# Complete second stage (runs i386 binaries via QEMU static)
RUN chroot /rootfs /debootstrap/debootstrap --second-stage || \
      { cat /rootfs/debootstrap/debootstrap.log; exit 1; }

# Clean apt cache to reduce size
RUN rm -rf /rootfs/var/cache/apt/archives/*.deb \
           /rootfs/var/lib/apt/lists/* \
           /rootfs/debootstrap

# Setup user without useradd (avoids audit interface error in Docker)
RUN printf '%s\n' 'user:x:1000:1000::/home/user:/bin/bash' >> /rootfs/etc/passwd && \
    printf '%s\n' 'user:x:1000:' >> /rootfs/etc/group && \
    printf '%s\n' 'user:$6$rebaaa$oU06PMGW2UxfRYrmT.4yroaLfjt6zAdlQVwpxZW4E2jlPuJhyqenhfgubONy.doSACjDOz9TCTfdmOEAoHpf4.:20000:0:99999:7:::' >> /rootfs/etc/shadow && \
    sed -i \
      -e 's#^root:[^:]*:#root:$6$rebaaa$oU06PMGW2UxfRYrmT.4yroaLfjt6zAdlQVwpxZW4E2jlPuJhyqenhfgubONy.doSACjDOz9TCTfdmOEAoHpf4.:#' \
      /rootfs/etc/shadow && \
    mkdir -p /rootfs/home/user

COPY --chown=1000:1000 ./examples /rootfs/home/user/examples
RUN chmod -R +x /rootfs/home/user/examples/lua && \
    chown -R 1000:1000 /rootfs/home/user && \
    echo 'root:password' | chroot /rootfs /bin/sh -c 'chpasswd' || true && \
    echo 'user:password' | chroot /rootfs /bin/sh -c 'chpasswd' || true

FROM scratch
COPY --from=builder /rootfs /

WORKDIR /home/user/
ENV HOME="/home/user" TERM="xterm" USER="user" SHELL="/bin/bash" EDITOR="vim" LANG="C.UTF-8"
CMD [ "/bin/bash" ]
